from fastapi import APIRouter
from pathlib import Path
import json

router = APIRouter(prefix="/demo", tags=["demo"])

DATA = Path(__file__).resolve().parents[1] / "data" / "demo_products.json"

def _load():
    if not DATA.exists():
        return []
    return json.loads(DATA.read_text(encoding="utf-8"))

@router.get("/products")
def demo_products():
    items = _load()
    return {"items": items, "count": len(items)}

@router.get("/products/{code}")
def demo_product(code: str):
    for it in _load():
        if it.get("code","").lower() == code.lower():
            return it
    return {"error": "not_found", "code": code}

def mount(root_app):
    try:
        if getattr(root_app.state, "__demo_real_mounted__", False):
            return
        root_app.state.__demo_real_mounted__ = True
    except Exception:
        pass

    sub = None
    for r in getattr(root_app, "routes", []):
        p = getattr(r, "path", None)
        if p in ("/api", "/api/") and hasattr(r, "app"):
            sub = r.app
            break

    if sub is not None and hasattr(sub, "include_router"):
        sub.include_router(router)       # /api/demo/*
        root_app.include_router(router)  # /demo/*
    else:
        root_app.include_router(router, prefix="/api")
        root_app.include_router(router)
"@ | Set-Content -Encoding UTF8 "E:\CLONAZIONE\tpi_evoluto\app\routers\demo_real.py"


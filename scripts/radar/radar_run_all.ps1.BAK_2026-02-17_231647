<##
# TPI Radar Run All Script (CLEAN)
# Order: 1) LIFE_MIN  2) MIX  3) DASHBOARD PDF+OPEN  4) EMAIL
##>

param(
    [string]$IntakePath = "E:\CLONAZIONE\REPORT_DELTA\INTAKE",
    [string]$ReportsDir = "E:\CLONAZIONE\REPORT_DELTA\REPORTS",
    [string]$RevisionFile = "SCADENZIARIO_REV.xlsx",
    [int]$RevHeaderRow = 3,
    [int]$WarnDays = 60
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

function Get-LatestReport {
    param([string]$Pattern)
    $files = Get-ChildItem -Path $ReportsDir -Filter $Pattern -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending
    if ($files.Count -gt 0) { return $files[0] }
    return $null
}

Write-Host '[1/4] Generating LIFE_MIN from the revision schedule...'
python 'E:\CLONAZIONE\tpi_evoluto\scripts\radar\life_min_2026-02-16.py'

$latestLife = Get-LatestReport -Pattern 'TPI_LIFE_MIN_*.xlsx'
if (-not $latestLife) { throw 'No LIFE_MIN file was generated. Aborting.' }

Write-Host ("[2/4] Generating the MIX report using " + $latestLife.Name + '...')
python 'E:\CLONAZIONE\tpi_evoluto\scripts\radar\radar_mix_FULL_2026-02-17.py' `
  --rev-xlsx (Join-Path $IntakePath $RevisionFile) `
  --life-xlsx $latestLife.FullName `
  --rev-sheet 0 `
  --life-sheet 0 `
  --rev-header $RevHeaderRow `
  --life-header 0 `
  --warn-days $WarnDays

Write-Host '[3/4] Generating Dashboard Rischio PDF (cliente) + OPEN...'
python 'E:\CLONAZIONE\tpi_evoluto\scripts\radar\dashboard_risk_pdf_2026-02-17.py'
$pdf = Get-LatestReport -Pattern 'TPI_DashboardRischio_*.pdf'
if ($pdf) { Start-Process $pdf.FullName }

Write-Host '[4/4] Sending MIX report email...'
python 'E:\CLONAZIONE\tpi_evoluto\scripts\radar\send_radar_proton_bridge_2026-02-16.py'

Write-Host 'Pipeline completed.'

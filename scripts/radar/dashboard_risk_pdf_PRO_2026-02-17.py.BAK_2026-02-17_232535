@dataclass
class RadarCounts:
    total: int
    rev_ok: int
    rev_warn: int
    rev_expired: int
    rev_unknown: int
    life_ok: int
    life_warn: int
    life_expired: int
    life_unknown: int
    mix_ok: int
    mix_warn: int
    mix_expired: int
    mix_unknown: int


def _int(maybe: str) -> int:
    return int(maybe.strip())


def parse_radar_report(text: str) -> RadarCounts:
    # Accetta anche il report "con \n letterali"
    t = text.replace("\\n", "\n")

    total = re.search(r"Totale:\s*(\d+)", t)
    if not total:
        raise ValueError("Non trovo 'Totale:' nel report.")
    total_n = _int(total.group(1))

    def grab(section: str, key: str) -> int:
        # es: "REV (revisione)\n  OK: 0\n  Warning: 3\n  Expired: 34\n  Unknown: 3"
        m = re.search(rf"{re.escape(section)}.*?\n\s*{re.escape(key)}:\s*(\d+)", t, flags=re.S)
        if not m:
            raise ValueError(f"Non trovo '{key}:' nella sezione '{section}'.")
        return _int(m.group(1))

    rev_ok = grab("REV (revisione)", "OK")
    rev_warn = grab("REV (revisione)", "Warning")
    rev_exp = grab("REV (revisione)", "Expired")
    rev_unk = grab("REV (revisione)", "Unknown")

    life_ok = grab("LIFE (fine vita)", "OK")
    life_warn = grab("LIFE (fine vita)", "Warning")
    life_exp = grab("LIFE (fine vita)", "Expired")
    life_unk = grab("LIFE (fine vita)", "Unknown")

    mix_ok = grab("MIX (rischio complessivo)", "OK")
    mix_warn = grab("MIX (rischio complessivo)", "Warning")
    mix_exp = grab("MIX (rischio complessivo)", "Expired")
    mix_unk = grab("MIX (rischio complessivo)", "Unknown")

    return RadarCounts(
        total=total_n,
        rev_ok=rev_ok,
        rev_warn=rev_warn,
        rev_expired=rev_exp,
        rev_unknown=rev_unk,
        life_ok=life_ok,
        life_warn=life_warn,
        life_expired=life_exp,
        life_unknown=life_unk,
        mix_ok=mix_ok,
        mix_warn=mix_warn,
        mix_expired=mix_exp,
        mix_unknown=mix_unk,
    )


def compute_risk_index(mix_expired: int, mix_warn: int, total: int) -> int:
    """
    Formula commerciale:
      score = (expired*2 + warning*1) / total
    Normalizzo in 0..100 usando max=2 (tutti expired).
    """
    if total <= 0:
        return 0
    score = (mix_expired * 2 + mix_warn * 1) / total  # 0..2
    idx = round(min(1.0, max(0.0, score / 2.0)) * 100)
    return int(idx)


def level_from_index(idx: int) -> str:
    if idx >= 80:
        return "CRITICO"
    if idx >= 50:
        return "MEDIO"
    return "CONTROLLATO"


def latest_report_file(reports_dir: Path) -> Path:
    files = sorted(reports_dir.glob("TPI_RadarMIX_*_REPORT.txt"), key=lambda p: p.stat().st_mtime, reverse=True)
    if not files:
        raise FileNotFoundError(f"Nessun REPORT.txt trovato in: {reports_dir}")
    return files[0]



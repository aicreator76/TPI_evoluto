from reportlab.lib.units import mm
from reportlab.lib import colors

def _pct(x: int, total: int) -> float:
    if total <= 0:
        return 0.0
    return round((x / total) * 100, 1)

def commercial_lines(counts: dict) -> dict:
    # counts atteso: {"expired":x,"warning":x,"unknown":x,"ok":x,"total":x} (se manca, calcolo)
    exp = int(counts.get("expired", 0) or 0)
    warn = int(counts.get("warning", 0) or 0)
    unk = int(counts.get("unknown", 0) or 0)
    okv = int(counts.get("ok", 0) or 0)
    total = int(counts.get("total", 0) or (exp + warn + unk + okv) or 1)

    return {
        "meaning": [
            f"Critici: {exp} ({_pct(exp,total)}%) | Attenzione: {warn} ({_pct(warn,total)}%)",
            f"Dati incompleti: {unk} ({_pct(unk,total)}%) → rischio di non tracciabilità",
            "Priorità: ridurre esposizione e ripristinare conformità in modo documentato",
        ],
        "todo": [
            "Blocca l’uso dei DPI critici e pianifica revisione/sostituzione",
            "Completa i dati mancanti (matricola, scadenze, documenti) per DPI sconosciuti",
            "Allinea lo scadenziario con evidenze (verbali, certificati, registri)",
        ],
        "next": [
            "Modulo 2: Piano di rientro + conformità post-intervento (tracciabilità completa)",
            "Schede DPI per modello + collegamento Manuali/Libretti (PDF digitali)",
            "Automazione: promemoria scadenze + report periodico per audit/cliente",
        ],
    }

def draw_commercial_box(c, x, y_top, w, h, title, lines):
    c.setStrokeColor(colors.black)
    c.setLineWidth(0.8)
    c.roundRect(x, y_top - h, w, h, 10, stroke=1, fill=0)

    c.setFont("Helvetica-Bold", 12)
    c.drawString(x + 6*mm, y_top - 10*mm, title)

    c.setFont("Helvetica", 10)
    ty = y_top - 18*mm
    for line in lines:
        c.drawString(x + 8*mm, ty, u"\u2022 " + line)
        ty -= 6*mm

def draw_page2(c, counts, stamp):
    # nuova pagina
    c.showPage()
    w, h = c._pagesize

    margin = 18*mm
    c.setFont("Helvetica-Bold", 18)
    c.drawString(margin, h - margin, "Dashboard Rischio DPI – Azioni")

    c.setFont("Helvetica", 10)
    c.drawString(margin, h - margin - 12*mm, f"Generato: {stamp}")
    total = int(counts.get("total", 0) or 0)
    if total:
        c.drawString(margin, h - margin - 18*mm, f"Totale DPI analizzati: {total}")

    boxes = commercial_lines(counts)

    box_w = w - 2*margin
    box_h = 42*mm
    y = h - margin - 30*mm

    draw_commercial_box(c, margin, y, box_w, box_h, "Cosa significa", boxes["meaning"])
    y -= (box_h + 8*mm)
    draw_commercial_box(c, margin, y, box_w, box_h, "Cosa fare subito", boxes["todo"])
    y -= (box_h + 8*mm)
    draw_commercial_box(c, margin, y, box_w, box_h, "Prossimo passo (Servizio Modulo 2)", boxes["next"])

    c.setFont("Helvetica-Oblique", 9)
    c.drawString(margin, 12*mm, "Nota: elenco completo e dettagli disponibili solo nella versione interna.")

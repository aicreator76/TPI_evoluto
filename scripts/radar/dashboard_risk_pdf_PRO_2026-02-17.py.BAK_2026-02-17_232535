def main() -> None:
    reports_dir = Path(REPORTS_DIR_DEFAULT)
    rep = latest_report_file(reports_dir)
    text = rep.read_text(encoding="utf-8", errors="ignore")

    counts = parse_radar_report(text)
    idx = compute_risk_index(counts.mix_expired, counts.mix_warn, counts.total)
    level = level_from_index(idx)

    stamp = datetime.now().strftime("%Y-%m-%d_%H%M")
    out_pdf = reports_dir / f"TPI_DashboardRischio_{stamp}.pdf"
    build_pdf(out_pdf, counts, idx, level, stamp)

    print("OK DASHBOARD PDF")
    print("REPORT:", rep.name)
    print("PDF   :", out_pdf)


if __name__ == "__main__":
    main()
